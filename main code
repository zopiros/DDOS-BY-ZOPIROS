def _is_master_or_local(environment: Any) -> bool:
    try:
        return not isinstance(environment.runner, WorkerRunner)
    except Exception:
        return True


@events.test_start.add_listener
def _on_test_start(environment: Any, **_kw: Any) -> None:
    if not _is_master_or_local(environment):
        return

    log.info("=" * 70)
    log.info("CHAOS TEST STARTED  (v∞++++ PATCHED EDITION)")
    log.info("Target     : %s", environment.host or "(missing!)")
    log.info("Endpoints  : %s", ", ".join(_ENDPOINT_LIST))
    log.info("Users      : up to %d in %d steps (spawn=%d/s)",
             TARGET_USERS, STEPS, SPAWN_RATE)
    log.info("Duration   : %ds", RUN_TIME)
    log.info("Mode       : strict=%s retry=%s insecure=%s burst=%s",
             STRICT, RETRY_ON_NET, INSECURE, BURST_MODE)
    log.info("Wild v1    : cache_bust=%s parallel_n=%d (p=%.2f) "
             "heavy=%d eps (p=%.2f) cold=%s (p=%.2f)",
             CACHE_BUST, PARALLEL_N, PARALLEL_PROB,
             len(HEAVY_ENDPOINTS), HEAVY_PROB,
             COLD_CONN, COLD_CONN_PROB)
    log.info("Wild v2    : spoof_ip=%s hdr_bomb=%s (%dKB) method_chaos=%s "
             "mutation=%.2f deep_page=%s thunder=%s (%.0f%%) pulse=%s",
             SPOOF_IP, HEADER_BOMB, HEADER_BOMB_KB, METHOD_CHAOS,
             MUTATION_PROB, DEEP_PAGINATION,
             THUNDER_HERD, THUNDER_THRESHOLD * 100, PULSE_SHAPE)
    log.info("=" * 70)

    if not environment.host:
        log.error("FATAL: --host is required. Aborting.")
        try:
            environment.runner.quit()
        except Exception:
            pass
        return

    try:
        signal.signal(signal.SIGTERM, lambda *_: environment.runner.quit())
    except (ValueError, AttributeError, OSError):
        pass

    stop_flag = _TEST_STATE["stop_flag"]

    def _progress_reporter() -> None:
        while not stop_flag["stop"]:
            gevent.sleep(15)
            if stop_flag["stop"]:
                break
            try:
                s = environment.stats.total
                total = max(1, s.num_requests)
                p95 = s.get_response_time_percentile(0.95) or 0
                log.info(
                    "progress → %d reqs | %.0f RPS | %.2f%% fail | p95=%dms",
                    s.num_requests, s.total_rps,
                    100.0 * s.num_failures / total, p95,
                )
            except Exception as exc:
                log.debug("progress error: %s", exc)

    def _watchdog() -> None:
        last_ok = {"count": 0, "ts": time.monotonic()}
        while not stop_flag["stop"]:
            gevent.sleep(10)
            if stop_flag["stop"]:
                break
            try:
                s = environment.stats.total
                cur = s.num_requests - s.num_failures
                if cur > last_ok["count"]:
                    last_ok["count"] = cur
                    last_ok["ts"] = time.monotonic()
                elif time.monotonic() - last_ok["ts"] > 30:
                    log.error("WATCHDOG: 30s no success — target may be down or blocked by WAF")
                    last_ok["ts"] = time.monotonic()
            except Exception as exc:
                log.debug("watchdog error: %s", exc)

    try:
        _TEST_STATE["progress_greenlet"] = gevent.spawn(_progress_reporter)
        _TEST_STATE["watchdog_greenlet"] = gevent.spawn(_watchdog)
    except Exception as exc:
        log.warning("Background tasks failed: %s", exc)


@events.test_stop.add_listener
def _on_test_stop(environment: Any, **_kw: Any) -> None:
    flag = _TEST_STATE["stop_flag"]
    flag["stop"] = True

    if not _is_master_or_local(environment):
        return

    try:
        s = environment.stats.total
        total = max(1, s.num_requests)
        log.info("=" * 70)
        log.info("FINAL REPORT")
        log.info("Requests    : %d", s.num_requests)
        log.info("Failures    : %d (%.2f%%)",
                 s.num_failures, 100.0 * s.num_failures / total)
        log.info("RPS (avg)   : %.1f", s.total_rps)
        log.info("Latency p50 : %d ms",
                 s.get_response_time_percentile(0.50) or 0)
        log.info("Latency p95 : %d ms",
                 s.get_response_time_percentile(0.95) or 0)
        log.info("Latency p99 : %d ms",
                 s.get_response_time_percentile(0.99) or 0)
        log.info("Max latency : %d ms", s.max_response_time or 0)
        log.info("=" * 70)
    except Exception as exc:
        log.warning("Final report failed: %s", exc)

