def _adaptive_pool_size() -> int:
    if TARGET_USERS <= 1_000:
        return min(POOL_SIZE, 50)
    if TARGET_USERS <= 10_000:
        return min(POOL_SIZE, 20)
    return min(POOL_SIZE, 10)


