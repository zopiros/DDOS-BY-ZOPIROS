def _iter_search_requests() -> Any:
    for base in _ENDPOINT_LIST:
        base = base.rstrip()
        sep = "&" if "?" in base else "?"
        prefix = f"{base}{sep}q="
        stat_name = f"GET {base}{sep}q=[pair]"  # FIX #9: Use sep here
        for a in _WORDS_A:
            ea = quote(a, safe="")
            for b in _WORDS_B:
                eb = quote(b, safe="")
                yield (f"{prefix}{ea}%20{eb}", stat_name)


_PREBUILT_REQUESTS: Tuple[Tuple[str, str], ...] = tuple(_iter_search_requests())

# FIX #20: Assert pre-built requests
if not _PREBUILT_REQUESTS:
    log.critical("FATAL: No requests could be built. Check ENDPOINTS.")
    sys.exit(1)

_random_choice = random.choice
_random_int = random.randint
_random_random = random.random


def _random_ip() -> str:
    """Generate a public IPv4 address (excluding private/reserved ranges)."""
    while True:
        a = _random_int(1, 223)
        b = _random_int(0, 255)
        c = _random_int(0, 255)
        d = _random_int(1, 254)
        
        # FIX #12: Filter private/reserved ranges
        if a == 10: continue
        if a == 127: continue
        if a == 169 and b == 254: continue
        if a == 172 and 16 <= b <= 31: continue
        if a == 192 and b == 168: continue
        if a >= 224: continue
        
        return f"{a}.{b}.{c}.{d}"


def rand_request() -> Tuple[str, str]:
    path, name = _random_choice(_PREBUILT_REQUESTS)
    
    if DEEP_PAGINATION and _random_random() < 0.5:
        sep = "&" if "?" in path else "?"
        offset = _random_int(10000, 10000000)
        path = f"{path}{sep}offset={offset}&limit=100"
        name = f"{name} [deep-page]"
        
    return path, name


def _maybe_cache_bust(path: str) -> str:
    if not CACHE_BUST:
        return path
    sep = "&" if "?" in path else "?"
    return f"{path}{sep}_cb={_random_int(1, 10**9)}"


# =============================================================================
#  User class
# =============================================================================
class MaxSearchUser(FastHttpUser):
    wait_time = constant(0)
    connection_pool_maxsize = _adaptive_pool_size()
    network_timeout = TIMEOUT
    insecure = INSECURE

    _STAT_HEALTH   = "[startup] reachability"  # FIX #16
    _STAT_RETRY    = "retry"
    _STAT_PARALLEL = "parallel burst"
    _STAT_HEAVY    = "heavy endpoint"
    _STAT_COLD     = "cold connection"
    _STAT_MUTATION = "mutation endpoint"
    _STAT_HERD     = "thundering herd"

    def on_start(self) -> None:
        try:
            self.client.headers.update(
                {"User-Agent": USER_AGENT, **EXTRA_HEADERS}
            )
        except Exception as exc:
            log.debug("Header setup failed: %s", exc)

        if SKIP_HEALTH:
            return

        try:
            with self.client.get(
                "/",
                name=self._STAT_HEALTH,
                catch_response=True,
                timeout=TIMEOUT,
                allow_redirects=False,
            ) as r:
                _ = r.content
                if r.status_code == 0:
                    r.failure("no response")
                else:
                    r.success()
        except Exception as exc:
            log.debug("Health check failed: %s", exc)

    @staticmethod
    def _classify_network_error(r: Any) -> str:
        exc = getattr(r, "exception", None) or getattr(r, "error", None)
        if exc is None:
            return "connection_error"
        name = type(exc).__name__
        if "Timeout" in name:
            return "timeout"
        if "SSL" in name or "TLS" in name:
            return "ssl_error"
        if "DNS" in name or "gaierror" in name:
            return "dns_error"
        if "Refused" in name:
            return "connection_refused"
        if "Reset" in name:
            return "connection_reset"
        if "BrokenPipe" in name:
            return "broken_pipe"
        return f"net_{name}"

    def _is_thunder_herd_active(self) -> bool:
        """Check if Thundering Herd should trigger (with cache and cooldown)."""
        if not THUNDER_HERD:
            return False
            
        now = time.monotonic()
        
        # FIX #17: Cache result for 500ms to prevent hotspot
        if now - _HERD_CACHE["ts"] < 0.5:
            return _HERD_CACHE["active"]
            
        active = False
        
        # FIX #4: Cooldown check
        if now - _HERD_STATE["last_trigger"] >= _HERD_COOLDOWN:
            # FIX #4: Rate limit check
            if now - _HERD_STATE["minute_start"] > 60.0:
                _HERD_STATE["minute_start"] = now
                _HERD_STATE["count_this_minute"] = 0
                
            if _HERD_STATE["count_this_minute"] < _HERD_MAX_PER_MIN:
                try:
                    s = self.environment.stats.total
                    if s.num_requests > 100:
                        # FIX #4: Raise threshold if METHOD_CHAOS is on (to avoid 4xx false triggers)
                        effective_threshold = THUNDER_THRESHOLD
                        if METHOD_CHAOS or MUTATION_PROB > 0:
                            effective_threshold = max(effective_threshold, 0.30)
                            
                        fail_rate = s.num_failures / s.num_requests
                        if fail_rate >= effective_threshold:
                            _HERD_STATE["last_trigger"] = now
                            _HERD_STATE["count_this_minute"] += 1
                            active = True
                except Exception:
                    pass
                    
        _HERD_CACHE["ts"] = now
        _HERD_CACHE["active"] = active
        return active

    def _roll_method_and_data(self) -> Tuple[str, Any]:
        if METHOD_CHAOS:
            m = _random_choice(["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"])
            if m in ("POST", "PUT", "PATCH"):
                return m, b'{"chaos": true, "ts": ' + str(int(time.time())).encode() + b'}'
            return m, None
        return "GET", None

    def _do_request(self, path: str, name: str, method: str = "GET", 
                    body: Any = None, extra_headers: Optional[Dict[str, str]] = None) -> None:
        """Execute request with validation and chaos injection."""
        chaos_headers = {}
        if extra_headers:
            chaos_headers.update(extra_headers)
            
        if SPOOF_IP:
            ip = _random_ip()
            chaos_headers["X-Forwarded-For"] = ip
            chaos_headers["X-Real-IP"] = ip
        if HEADER_BOMB:
            chaos_headers["X-Chaos-Bomb"] = _HEADER_BOMB_VAL
            
        # FIX #3: Auto-inject Content-Type for body payloads
        if body is not None:
            chaos_headers.setdefault("Content-Type", "application/json")
            
        try:
            kwargs: Dict[str, Any] = {"catch_response": True, "headers": chaos_headers}
            if body is not None:
                kwargs["body"] = body
                
            with self.client.request(method, path, name=name, **kwargs) as r:
                code = r.status_code
                body_resp = r.content

                if code == 0:
                    if RETRY_ON_NET:
                        with self.client.request(method, path, name=name + " (retry)", **kwargs) as r2:
                            _ = r2.content
                            if r2.status_code == 200:
                                r2.success()
                            else:
                                r2.failure(f"retry_http_{r2.status_code}")
                        r.success()
                    else:
                        r.failure(self._classify_network_error(r))
                    return

                # FIX #11: Unified non-strict behavior
                if not STRICT:
                    if code >= 400:
                        r.failure(f"http_{code}")
                    else:
                        r.success()
                    return

                if 200 <= code < 300:
                    # FIX #1: Only check Content-Length if not compressed
                    content_encoding = r.headers.get("Content-Encoding") or r.headers.get("content-encoding")
                    if not content_encoding:
                        cl = r.headers.get("Content-Length")
                        if cl is not None:
                            try:
                                if len(body_resp) != int(cl):
                                    r.failure(f"truncated_{len(body_resp)}_of_{cl}")
                                    return
                            except (ValueError, TypeError):
                                pass
                    
                    # FIX #2: Ignore empty body for 204/205/HEAD/OPTIONS
                    if len(body_resp) < 5 and code not in (204, 205) and method not in ("HEAD", "OPTIONS"):
                        r.failure("suspicious_empty_body")
                        return
                    r.success()
                    return

                if 300 <= code < 400:
                    r.failure(f"redirect_{code}")
                    return
                if 400 <= code < 500:
                    r.failure(f"client_error_{code}")
                    return
                if 500 <= code < 600:
                    r.failure(f"server_error_{code}")
                    return
                r.failure(f"unexpected_{code}")
        except Exception as exc:
            log.warning("Request exception: %s", exc)  # FIX #10

    def _parallel_burst(self) -> None:
        group = Group()
        for _ in range(PARALLEL_N):
            path, _ = rand_request()
            method, body = self._roll_method_and_data()
            group.spawn(self._do_request,
                        _maybe_cache_bust(path),
                        self._STAT_PARALLEL, method, body)
        group.join()

    def _heavy_request(self) -> None:
        ep = _random_choice(HEAVY_ENDPOINTS)
        self._do_request(ep, self._STAT_HEAVY)

    def _cold_request(self) -> None:
        """FIX #5: Pass Connection: close as extra_headers to avoid race condition."""
        path, _ = rand_request()
        method, body = self._roll_method_and_data()
        self._do_request(path, self._STAT_COLD, method, body, 
                         extra_headers={"Connection": "close"})

    def _mutation_request(self) -> None:
        ep = _random_choice(MUTATION_ENDPOINTS)
        method = _random_choice(["POST", "PUT", "DELETE"])
        body = b'{"mutation_chaos": true}' if method != "DELETE" else None
        self._do_request(ep, self._STAT_MUTATION, method=method, body=body)

    @tag("stress")
    @task(1)
    def stress_task(self) -> None:
        if self._is_thunder_herd_active():
            for _ in range(3):
                path, name = rand_request()
                method, body = self._roll_method_and_data()
                self._do_request(_maybe_cache_bust(path), f"{name} (herd)", method, body)
            return

        roll = _random_random()

        if MUTATION_PROB > 0.0 and roll < MUTATION_PROB:
            self._mutation_request()
            return

        roll -= MUTATION_PROB

        if (PARALLEL_N > 1 and PARALLEL_PROB > 0.0
                and roll < PARALLEL_PROB):
            self._parallel_burst()
            return

        roll -= PARALLEL_PROB if PARALLEL_N > 1 else 0.0

        if HEAVY_ENDPOINTS and HEAVY_PROB > 0.0 and roll < HEAVY_PROB:
            self._heavy_request()
            return

        if HEAVY_ENDPOINTS and HEAVY_PROB > 0.0:
            roll -= HEAVY_PROB

        if COLD_CONN and COLD_CONN_PROB > 0.0 and roll < COLD_CONN_PROB:
            self._cold_request()
            return

        path, name = rand_request()
        method, body = self._roll_method_and_data()
        self._do_request(_maybe_cache_bust(path), name, method, body)


# =============================================================================
#  Load shape
# =============================================================================
class AdvancedLoadShape(LoadTestShape):
    _step_duration = RUN_TIME / STEPS
    _base_users    = TARGET_USERS // STEPS
    _remainder     = TARGET_USERS - _base_users * STEPS
    
    _pulse_cycles = 3
    _pulse_cycle_time = RUN_TIME / _pulse_cycles
    _pulse_ramp_time = _pulse_cycle_time * 0.7

    def tick(self) -> Optional[Tuple[int, int]]:
        t = self.get_run_time()
        if t >= RUN_TIME:
            return None

        if PULSE_SHAPE:
            cycle_t = t % self._pulse_cycle_time
            if cycle_t < self._pulse_ramp_time:
                progress = cycle_t / self._pulse_ramp_time
                users = int(TARGET_USERS * progress)
                return (max(1, users), SPAWN_RATE)
            else:
                # FIX #13: Clamp spawn rate
                return (max(1, int(TARGET_USERS * 0.05)), min(SPAWN_RATE * 2, 10000))

        if BURST_MODE:
            return (TARGET_USERS, SPAWN_RATE)

        rung = min(int(t // self._step_duration) + 1, STEPS)
        users = self._base_users * rung
        if rung == STEPS:
            users += self._remainder
        return (users, SPAWN_RATE)


