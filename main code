def _env_int(name: str, default: int, min_val: int = 1,
             max_val: Optional[int] = None) -> int:
    raw = os.getenv(name)
    if raw is None or not raw.strip():
        return default
    try:
        v = int(raw.strip())
    except (ValueError, TypeError):
        log.warning("ENV %s=%r not int → default %d", name, raw, default)
        return default
    if v < min_val or (max_val is not None and v > max_val):
        log.warning("ENV %s=%d out of [%d,%s] → default %d",
                    name, v, min_val, max_val, default)
        return default
    return v


def _env_float(name: str, default: float, min_val: float = 0.0,
               max_val: Optional[float] = None) -> float:
    raw = os.getenv(name)
    if raw is None or not raw.strip():
        return default
    try:
        v = float(raw.strip())
    except (ValueError, TypeError):
        log.warning("ENV %s=%r not float → default %s", name, raw, default)
        return default
    if v < min_val or (max_val is not None and v > max_val):
        log.warning("ENV %s=%s out of range → default %s", name, v, default)
        return default
    return v


def _env_bool(name: str, default: bool = False) -> bool:
    raw = os.getenv(name)
    if raw is None:
        return default
    return raw.strip().lower() in ("1", "true", "yes", "on")


def _env_str(name: str, default: str) -> str:
    raw = os.getenv(name)
    if raw is None:
        return default
    raw = raw.strip()
    return raw if raw else default


def _env_csv(name: str, default: str = "") -> Tuple[str, ...]:
    raw = os.getenv(name, default)
    if not raw:
        return ()
    return tuple(item.strip() for item in raw.split(",") if item.strip())


